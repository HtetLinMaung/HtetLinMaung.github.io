		<script is:inline>
			if (!window.__portfolioNavIndicatorInit) {
				window.__portfolioNavIndicatorInit = true;

				const normalizePath = (value) => {
					if (!value) return "/";
					const trimmed = value.replace(/\/+$/, "");
					return trimmed || "/";
				};

				const updateNavIndicator = () => {
					const nav = document.querySelector(".nav");
					if (!nav) return;

					const links = Array.from(nav.querySelectorAll("[data-nav-link]"));
					const indicator = nav.querySelector(".nav-indicator");
					if (!links.length || !indicator) return;

					const currentPathname = normalizePath(window.location.pathname);
					let activeLink = links.find((link) => {
						const href = link.getAttribute("href");
						if (!href) return false;

						const pathname = normalizePath(new URL(href, window.location.origin).pathname);
						if (pathname === "/") {
							return currentPathname === "/";
						}

						return currentPathname === pathname || currentPathname.startsWith(`${pathname}/`);
					});

					links.forEach((link) => {
						const isActive = link === activeLink;
						link.classList.toggle("active", isActive);
						if (isActive) {
							link.setAttribute("aria-current", "page");
						} else {
							link.removeAttribute("aria-current");
						}
					});

					if (!activeLink) {
						nav.classList.add("nav-enhanced");
						indicator.style.opacity = "0";
						return;
					}

					const navRect = nav.getBoundingClientRect();
					const linkRect = activeLink.getBoundingClientRect();
					const inlinePadding = 16;
					const width = Math.max(linkRect.width - inlinePadding * 2, 20);
					const offset = linkRect.left - navRect.left + inlinePadding;

					nav.classList.add("nav-enhanced");
					indicator.style.width = `${width}px`;
					indicator.style.transform = `translateX(${offset}px)`;
					indicator.style.opacity = "1";
				};

				const queueNavIndicatorUpdate = () => {
					requestAnimationFrame(() => {
						updateNavIndicator();
						requestAnimationFrame(updateNavIndicator);
					});
				};

				const syncCvButtons = () => {
					const desktopCv = document.querySelector("[data-desktop-cv]");
					const mobileCv = document.querySelector("[data-mobile-cv]");
					if (!desktopCv || !mobileCv) return;

					const desktopVisible = window.getComputedStyle(desktopCv).display !== "none";
					mobileCv.hidden = desktopVisible;
				};

				const isRegionAllowed = () => {
					const localHosts = new Set(["localhost", "127.0.0.1", "::1"]);
					if (localHosts.has(window.location.hostname)) return true;

					const allowedRegions = new Set(["JP", "MM"]);
					const allowedTimeZones = new Set(["Asia/Tokyo", "Asia/Yangon", "Asia/Rangoon"]);
					const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
					const languages = navigator.languages?.length
						? navigator.languages
						: [navigator.language];

					return (
						allowedTimeZones.has(timeZone) ||
						languages.some((language) => {
							try {
								return allowedRegions.has(new Intl.Locale(language).region ?? "");
							} catch {
								return /[-_](JP|MM)\b/i.test(language);
							}
						})
					);
				};

				const syncRegionLimitedLinks = () => {
					const allowed = isRegionAllowed();

					document.querySelectorAll("[data-region-limited]").forEach((link) => {
						if (!(link instanceof HTMLAnchorElement)) return;

						const destination = allowed
							? link.dataset.regionHref
							: link.dataset.regionFallback;
						if (destination) link.href = destination;
					});
				};

				const syncMobileMenu = (expanded) => {
					const header = document.querySelector(".site-header");
					const toggle = document.querySelector(".nav-toggle");
					if (!header || !toggle) return;

					header.classList.toggle("menu-open", expanded);
					toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
					toggle.setAttribute("aria-label", expanded ? "Close menu" : "Open menu");
				};

				const closeMobileMenu = () => syncMobileMenu(false);

				document.addEventListener("click", (event) => {
					const toggle = event.target instanceof Element ? event.target.closest(".nav-toggle") : null;
					if (toggle) {
						const isExpanded = toggle.getAttribute("aria-expanded") === "true";
						syncMobileMenu(!isExpanded);
						return;
					}

					const navLink = event.target instanceof Element ? event.target.closest(".nav [data-nav-link]") : null;
					if (navLink && window.matchMedia("(max-width: 1120px)").matches) {
						closeMobileMenu();
						return;
					}

					const header = document.querySelector(".site-header");
					if (
						header?.classList.contains("menu-open") &&
						event.target instanceof Element &&
						!event.target.closest(".site-header")
					) {
						closeMobileMenu();
					}
				});

				window.addEventListener("resize", queueNavIndicatorUpdate);
				window.addEventListener("resize", () => {
					syncCvButtons();
					if (!window.matchMedia("(max-width: 1120px)").matches) {
						closeMobileMenu();
					}
				});
				document.addEventListener("astro:page-load", () => {
					queueNavIndicatorUpdate();
					syncCvButtons();
					syncRegionLimitedLinks();
					closeMobileMenu();
				});
				document.addEventListener("DOMContentLoaded", () => {
					queueNavIndicatorUpdate();
					syncCvButtons();
					syncRegionLimitedLinks();
				}, { once: true });

				if (document.fonts?.ready) {
					document.fonts.ready.then(() => {
						queueNavIndicatorUpdate();
						syncCvButtons();
					});
				}

				queueNavIndicatorUpdate();
				syncCvButtons();
				syncRegionLimitedLinks();
			}
		</script>
	</body>
</html>
