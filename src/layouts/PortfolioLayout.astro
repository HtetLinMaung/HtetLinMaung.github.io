---
import { ClientRouter } from "astro:transitions";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/manrope/700.css";
import "@fontsource/manrope/800.css";

import Icon from "../components/Icon.astro";
import LogoMark from "../components/LogoMark.astro";
import { contactItems, navItems } from "../data/portfolio";
import { withBase } from "../utils/paths";

const {
	title = "Htet Lin Maung | Portfolio",
	currentPath = "/",
	regionGuard = false,
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const notFoundPath = `${baseUrl.replace(/\/?$/, "/")}404`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
		<style is:global>
			:root {
				--bg: #f7f9ff;
				--surface: #ffffff;
				--surface-soft: #f4f7ff;
				--line: #e7ecf8;
				--text: #0f1b3d;
				--muted: #58657f;
				--accent: #2c63f1;
				--accent-deep: #16337b;
				--card-shadow: 0 18px 48px rgba(15, 27, 61, 0.08);
				--ease-out-quint: cubic-bezier(0.22, 1, 0.36, 1);
				--ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
			}

			* {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
				scrollbar-color: #9db7fb rgba(231, 236, 248, 0.7);
				scrollbar-width: thin;
			}

			body {
				margin: 0;
				min-width: 320px;
				font-family: "Inter", "Segoe UI", sans-serif;
				font-weight: 400;
				background:
					radial-gradient(circle at 20% 12%, rgba(44, 99, 241, 0.08), transparent 0 28rem),
					radial-gradient(circle at 80% 40%, rgba(18, 51, 123, 0.05), transparent 0 22rem),
					linear-gradient(180deg, #ffffff 0%, var(--bg) 100%);
				color: var(--text);
			}

			body::-webkit-scrollbar {
				width: 0.8rem;
				height: 0.8rem;
			}

			body::-webkit-scrollbar-track {
				background: rgba(231, 236, 248, 0.7);
			}

			body::-webkit-scrollbar-thumb {
				border: 3px solid rgba(231, 236, 248, 0.7);
				border-radius: 999px;
				background: linear-gradient(180deg, #a9c0ff 0%, #6f99fb 100%);
			}

			body::-webkit-scrollbar-thumb:hover {
				background: linear-gradient(180deg, #8fb0ff 0%, #4f7df4 100%);
			}

			h1,
			h2,
			h3,
			h4,
			h5,
			h6,
			.brand-name,
			.nav a,
			.button,
			.project-tag,
			.text-link,
			.eyebrow,
			.stat-card strong {
				font-family: "Manrope", "Inter", sans-serif;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			img,
			svg {
				display: block;
				max-width: 100%;
			}

			.container {
				width: min(1240px, calc(100% - 48px));
				margin: 0 auto;
			}

			.site-header {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 100;
				background: rgba(255, 255, 255, 0.96);
				border-bottom: 1px solid #edf1fa;
				backdrop-filter: blur(14px);
			}

			main {
				padding-top: 5.4rem;
			}

			.header-inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1.5rem;
				padding: 0.86rem 0;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.78rem;
			}

			.brand-mark {
				display: inline-block;
				width: 2.5rem;
				height: 2.15rem;
				flex: none;
			}

			.brand-name {
				font-size: 1.02rem;
				letter-spacing: -0.03em;
				font-weight: 700;
			}

			.nav {
				position: relative;
				display: flex;
				align-items: center;
				gap: 0.25rem;
			}

			.nav .nav-mobile-cta {
				display: none;
			}

			.nav a {
				position: relative;
				display: inline-flex;
				align-items: center;
				padding: 0.64rem 1rem;
				font-size: 0.86rem;
				font-weight: 700;
				color: #202e52;
			}

			.nav a.active {
				color: var(--accent-deep);
			}

			.nav a.active::after {
				content: "";
				position: absolute;
				left: 1rem;
				right: 1rem;
				bottom: -0.88rem;
				height: 2px;
				border-radius: 999px;
				background: var(--accent);
			}

			.nav.nav-enhanced a.active::after {
				opacity: 0;
			}

			.nav-indicator {
				position: absolute;
				left: 0;
				bottom: -0.88rem;
				height: 2px;
				width: 0;
				border-radius: 999px;
				background: var(--accent);
				opacity: 0;
				pointer-events: none;
				transform: translateX(0);
				transition:
					transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
					width 260ms cubic-bezier(0.22, 1, 0.36, 1),
					opacity 160ms ease;
			}

			.nav:not(.nav-enhanced) .nav-indicator {
				display: none;
			}

			.nav-toggle {
				display: none;
				align-items: center;
				justify-content: center;
				width: 2.9rem;
				height: 2.9rem;
				padding: 0;
				border: 1px solid #dbe4f8;
				border-radius: 0.82rem;
				background: #ffffff;
				color: #14264f;
				cursor: pointer;
				box-shadow: 0 8px 20px rgba(15, 27, 61, 0.06);
			}

			.nav-toggle-bars {
				position: relative;
				width: 1.15rem;
				height: 0.95rem;
			}

			.nav-toggle-bars span {
				position: absolute;
				left: 0;
				width: 100%;
				height: 2px;
				border-radius: 999px;
				background: currentColor;
				transition:
					transform 180ms ease,
					opacity 180ms ease,
					top 180ms ease;
			}

			.nav-toggle-bars span:nth-child(1) {
				top: 0.05rem;
			}

			.nav-toggle-bars span:nth-child(2) {
				top: 0.42rem;
			}

			.nav-toggle-bars span:nth-child(3) {
				top: 0.79rem;
			}

			.site-header.menu-open .nav-toggle-bars span:nth-child(1) {
				top: 0.42rem;
				transform: rotate(45deg);
			}

			.site-header.menu-open .nav-toggle-bars span:nth-child(2) {
				opacity: 0;
			}

			.site-header.menu-open .nav-toggle-bars span:nth-child(3) {
				top: 0.42rem;
				transform: rotate(-45deg);
			}

			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.55rem;
				min-height: 3rem;
				padding: 0.78rem 1.25rem;
				border-radius: 0.75rem;
				border: 1px solid transparent;
				font-weight: 700;
				font-size: 0.9rem;
				transition:
					transform 180ms var(--ease-out-quint),
					box-shadow 180ms var(--ease-out-quint),
					border-color 180ms var(--ease-out-quint),
					background-color 180ms var(--ease-out-quint),
					color 180ms var(--ease-out-quint);
			}

			.button:hover {
				transform: translateY(-2px);
				box-shadow: 0 14px 28px rgba(15, 27, 61, 0.1);
			}

			.button.primary {
				background: linear-gradient(180deg, #2f69ff 0%, #1f57e3 100%);
				box-shadow: 0 10px 22px rgba(44, 99, 241, 0.2);
				color: #ffffff;
			}

			.button.secondary {
				background: #ffffff;
				border-color: #b9ccfa;
				color: var(--accent);
			}

			.button.secondary:hover {
				border-color: #8eacf4;
				background: #f6f9ff;
				box-shadow: 0 12px 24px rgba(44, 99, 241, 0.1);
			}

			.icon {
				width: 1.18rem;
				height: 1.18rem;
				flex: none;
			}

			.header-inner > .button {
				min-height: 2.8rem;
				padding: 0.7rem 1.1rem;
				border-radius: 0.68rem;
				font-size: 0.82rem;
			}

			.page-banner {
				padding: 3.6rem 0 2rem;
			}

			.about-hero-grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(20rem, 23rem);
				gap: clamp(3.5rem, 7vw, 6rem);
				align-items: center;
			}

			.about-hero-copy {
				max-width: 44rem;
			}

			.page-banner .eyebrow {
				margin-bottom: 0.8rem;
			}

			.page-banner h1 {
				margin: 0;
				font-size: clamp(2.6rem, 4.4vw, 4.3rem);
				line-height: 1.06;
				letter-spacing: -0.06em;
			}

			.page-banner p {
				max-width: 42rem;
				margin: 1rem 0 0;
				font-size: 1.02rem;
				line-height: 1.85;
				color: var(--muted);
			}

			.page-banner .detail-item p {
				margin: 0;
				max-width: none;
				line-height: 1.7;
			}

			.section {
				padding: 2.6rem 0 0;
			}

			.section-head {
				text-align: center;
				margin-bottom: 2.6rem;
			}

			.eyebrow {
				margin: 0 0 0.7rem;
				font-size: 0.78rem;
				font-weight: 800;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--accent);
			}

			.section-title {
				margin: 0;
				font-size: clamp(2.05rem, 2.45vw, 3rem);
				line-height: 1.22;
				letter-spacing: -0.04em;
			}

			.hero {
				padding: 0.1rem 0 1.8rem;
			}

			.hero-grid {
				display: grid;
				grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
				align-items: center;
				gap: 1.35rem;
			}

			.hero-copy {
				padding: 3.4rem 0 2rem;
			}

			.hero-greeting {
				display: flex;
				align-items: center;
				gap: 0.55rem;
				margin: 0 0 1rem;
				font-size: 0.98rem;
				color: #344364;
			}

			.wave {
				font-size: 1.4rem;
			}

			.hero-copy h1 {
				margin: 0;
				font-size: clamp(3.3rem, 5.6vw, 4.65rem);
				line-height: 1.04;
				letter-spacing: -0.06em;
				font-weight: 800;
			}

			.hero-role {
				margin: 1rem 0 1.15rem;
				font-size: clamp(1.45rem, 2vw, 2rem);
				font-weight: 700;
				color: var(--accent);
			}

			.hero-copy p,
			.page-copy {
				max-width: 31rem;
				margin: 0;
				font-size: 0.99rem;
				line-height: 1.95;
				color: var(--muted);
			}

			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 1.35rem;
				margin-top: 2.35rem;
			}

			.hero-actions .button {
				min-height: 2.95rem;
				padding: 0.88rem 1.35rem;
				border-radius: 0.78rem;
				font-size: 0.9rem;
			}

			.hero-actions .button.primary {
				background: linear-gradient(180deg, #2f69ff 0%, #1f57e3 100%);
				box-shadow: 0 12px 26px rgba(44, 99, 241, 0.22);
			}

			.socials {
				display: flex;
				gap: 1.35rem;
				margin-top: 2rem;
			}

			.socials a {
				display: grid;
				place-items: center;
				width: 2.75rem;
				aspect-ratio: 1;
				border: 1px solid transparent;
				border-radius: 0.75rem;
				transition:
					transform 180ms var(--ease-out-quint),
					background-color 180ms var(--ease-out-quint),
					border-color 180ms var(--ease-out-quint);
			}

			.socials a:hover {
				transform: translateY(-2px);
			}

			.socials .social-github {
				border-color: rgba(24, 23, 23, 0.09);
				background: rgba(24, 23, 23, 0.045);
				color: #181717;
			}

			.socials .social-github:hover {
				border-color: rgba(24, 23, 23, 0.18);
				background: rgba(24, 23, 23, 0.08);
			}

			.socials .social-linkedin {
				border-color: rgba(10, 102, 194, 0.12);
				background: rgba(10, 102, 194, 0.06);
				color: #0a66c2;
			}

			.socials .social-linkedin:hover {
				border-color: rgba(10, 102, 194, 0.22);
				background: rgba(10, 102, 194, 0.1);
			}

			.socials .icon {
				width: 1.32rem;
				height: 1.32rem;
			}

			.hero-frame {
				position: relative;
				overflow: hidden;
			}

			.hero-frame::after {
				content: "";
				position: absolute;
				right: 0.3rem;
				bottom: 8.5rem;
				width: 4rem;
				height: 6rem;
				background-image: radial-gradient(circle, rgba(44, 99, 241, 0.55) 1.5px, transparent 1.5px);
				background-size: 14px 14px;
				opacity: 0.5;
			}

			.services-grid,
			.projects-grid,
			.skills-grid,
			.stats-grid,
			.preview-grid,
			.home-highlights {
				display: grid;
				gap: 1.45rem;
			}

			.home-highlights-section {
				position: relative;
				margin-top: 0;
				padding: clamp(4.5rem, 7vw, 6.8rem) 0;
				border-block: 1px solid rgba(218, 226, 243, 0.78);
				background:
					radial-gradient(circle at 8% 50%, rgba(44, 99, 241, 0.065), transparent 22rem),
					rgba(250, 252, 255, 0.66);
			}

			.home-highlights-layout {
				display: grid;
				grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.28fr);
				gap: clamp(4rem, 8vw, 8.5rem);
				align-items: start;
			}

			.home-highlights-intro {
				max-width: 25rem;
			}

			.home-highlights-intro .section-title {
				max-width: 8ch;
				font-size: clamp(2.5rem, 4vw, 4.2rem);
				line-height: 1.05;
			}

			.home-highlights-intro > p:last-child {
				max-width: 22rem;
				margin: 1.35rem 0 0;
				font-size: 0.92rem;
				line-height: 1.8;
				color: var(--muted);
			}

			.home-highlights {
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.3rem clamp(2rem, 4vw, 4.5rem);
			}

			.home-highlight {
				display: grid;
				grid-template-columns: 2.7rem minmax(0, 1fr);
				gap: 1rem;
				align-items: start;
				min-width: 0;
				padding: 1.35rem 0 1.55rem;
				border-top: 1px solid #cfd9ed;
			}

			.home-highlight-icon {
				display: grid;
				place-items: center;
				width: 2.7rem;
				height: 2.7rem;
				color: #2f69ff;
			}

			.home-highlight-icon .icon {
				width: 2rem;
				height: 2rem;
			}

			.home-highlight-copy {
				min-width: 0;
				padding-top: 0.15rem;
			}

			.home-highlight-copy h3 {
				margin: 0 0 0.55rem;
				font-size: 1.08rem;
				font-weight: 800;
				line-height: 1.25;
				letter-spacing: -0.025em;
				color: #13234a;
			}

			.home-highlight-copy p {
				margin: 0;
				font-size: 0.84rem;
				line-height: 1.72;
				color: #65728b;
			}

			.services-grid {
				grid-template-columns: repeat(5, minmax(0, 1fr));
				margin-top: 3rem;
			}

			.projects-grid {
				grid-template-columns: repeat(3, minmax(0, 1fr));
				margin-top: 2.9rem;
			}

			.preview-grid {
				grid-template-columns: repeat(3, minmax(0, 1fr));
				margin-top: 2.4rem;
			}

			.service-card,
			.project-card,
			.stat-card,
			.footer-panel,
			.skill-group,
			.timeline-card,
			.contact-card,
			.page-panel,
			.preview-card {
				background: rgba(255, 255, 255, 0.92);
				border: 1px solid rgba(226, 233, 248, 0.95);
				box-shadow: var(--card-shadow);
			}

			.service-card {
				padding: 1.8rem 1.45rem 1.35rem;
				border-radius: 1.35rem;
				min-height: 13.6rem;
				text-align: center;
			}

			.service-icon {
				display: grid;
				place-items: center;
				width: 4.95rem;
				aspect-ratio: 1;
				margin: 0 auto 1.45rem;
				border-radius: 50%;
				color: var(--accent);
				background: linear-gradient(180deg, #f4f7ff, #e9f0ff);
			}

			.service-icon .icon {
				width: 2.15rem;
				height: 2.15rem;
			}

			.service-card h3,
			.project-card h3,
			.skill-group h3,
			.timeline-item h3,
			.contact-card h3,
			.preview-card h3 {
				margin: 0 0 0.65rem;
				font-size: 1.05rem;
				letter-spacing: -0.04em;
				font-weight: 800;
			}

			.service-card p,
			.project-card p,
			.page-copy,
			.timeline-item p,
			.contact-card p,
			.preview-card p {
				margin: 0;
				font-size: 0.85rem;
				line-height: 1.72;
				color: var(--muted);
			}

			.service-card p {
				font-size: 0.8rem;
				line-height: 1.68;
			}

			.project-card {
				display: flex;
				flex-direction: column;
				border-radius: 1.4rem;
				overflow: hidden;
				transition:
					transform 220ms var(--ease-out-quint),
					box-shadow 220ms var(--ease-out-quint),
					border-color 220ms var(--ease-out-quint);
			}

			.project-card:hover {
				transform: translateY(-4px);
				box-shadow: 0 22px 44px rgba(15, 27, 61, 0.11);
				border-color: #dbe5fb;
			}

			.project-archive-section {
				padding-top: clamp(3.5rem, 6vw, 5rem);
			}

			.project-archive-grid {
				margin-top: 2.2rem;
			}

			.project-visual {
				position: relative;
				height: 17rem;
				background: linear-gradient(135deg, #eff5ff, #f8fbff);
				border-bottom: 1px solid #e8eefc;
				overflow: hidden;
			}

			.project-visual.dashboard::before,
			.project-visual.mobile::before,
			.project-visual.product::before,
			.project-visual.ingest::before {
				content: "";
				position: absolute;
				inset: 1.2rem;
				border-radius: 1rem;
			}

			.project-visual.dashboard::before {
				background:
					linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 28%),
					linear-gradient(135deg, #111f3f, #10295a);
			}

			.project-visual.dashboard::after {
				content: "";
				position: absolute;
				inset: 2rem 2.1rem 2rem 2rem;
				border-radius: 0.9rem;
				background:
					linear-gradient(90deg, rgba(255, 255, 255, 0.09) 0 20%, transparent 20% 100%),
					radial-gradient(circle at 65% 35%, rgba(34, 197, 94, 0.6) 0 12%, transparent 12.5%),
					linear-gradient(180deg, rgba(255, 255, 255, 0.1) 0 18%, transparent 18% 100%);
			}

			.project-visual.mobile::before {
				background:
					radial-gradient(circle at 25% 25%, #6f7dd8, transparent 0 16%),
					linear-gradient(135deg, #ebeefe, #dcf5ff);
			}

			.project-visual.mobile::after {
				content: "";
				position: absolute;
				left: 50%;
				top: 1.5rem;
				width: 6rem;
				height: 12.5rem;
				border-radius: 1.8rem;
				transform: translateX(-50%);
				background: linear-gradient(180deg, #0e1630, #1a2549);
				box-shadow:
					-6.7rem 1.1rem 0 -1rem rgba(29, 42, 84, 0.92),
					6.7rem 1.1rem 0 -1rem rgba(29, 42, 84, 0.92);
			}

			.project-visual.product::before {
				background: linear-gradient(135deg, #fffefc, #f7fbff);
			}

			.project-visual.product::after {
				content: "";
				position: absolute;
				inset: 2rem;
				border-radius: 0.9rem;
				background:
					radial-gradient(circle at 26% 26%, #ff7a59 0 2.3%, transparent 2.4%),
					radial-gradient(circle at 34% 20%, #ef527e 0 1.8%, transparent 1.9%),
					radial-gradient(circle at 30% 31%, #fdba74 0 1.5%, transparent 1.6%),
