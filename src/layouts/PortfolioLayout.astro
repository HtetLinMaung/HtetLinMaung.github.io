		{
			regionGuard && (
				<>
					<script is:inline data-astro-rerun define:vars={{ notFoundPath }}>
						(() => {
							const localHosts = new Set(["localhost", "127.0.0.1", "::1"]);

							if (localHosts.has(window.location.hostname)) {
								return;
							}

							const allowedRegions = new Set(["JP", "MM"]);
							const allowedTimeZones = new Set(["Asia/Tokyo", "Asia/Yangon", "Asia/Rangoon"]);
							const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
							const languages = navigator.languages?.length
								? navigator.languages
								: [navigator.language];
							const hasAllowedRegion = languages.some((language) => {
								try {
									return allowedRegions.has(new Intl.Locale(language).region ?? "");
								} catch {
									return /[-_](JP|MM)\b/i.test(language);
								}
							});

							if (allowedTimeZones.has(timeZone) || hasAllowedRegion) {
								return;
							}

							window.location.replace(notFoundPath);
						})();
					</script>
				</>
			)
		}
