---
import Icon from "../components/Icon.astro";
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import { withBase } from "../utils/paths";
---

<PortfolioLayout title="Page Not Found | Htet Lin Maung" currentPath="/404">
	<section class="not-found" aria-labelledby="not-found-title">
		<div class="container not-found-grid">
			<div class="not-found-copy">
				<p class="eyebrow">404 / Page Not Found</p>
				<h1 id="not-found-title">We couldn’t find this page.</h1>
				<p class="not-found-message">
					The link may be outdated, or the page may have moved. You can return home or
					browse my projects.
				</p>

				<div class="not-found-actions">
					<a class="button primary not-found-primary" href={withBase("/")}>
						Back to Home
						<Icon name="arrow" />
					</a>
					<a class="button secondary" href={withBase("/projects")}>View Projects</a>
				</div>
			</div>

			<div class="not-found-visual" aria-hidden="true">
				<svg viewBox="0 0 640 430" role="presentation">
					<defs>
						<linearGradient id="error-zero" x1="0" y1="0" x2="1" y2="1">
							<stop offset="0" stop-color="#477dff" />
							<stop offset="1" stop-color="#2154db" />
						</linearGradient>
						<filter id="error-shadow" x="-30%" y="-30%" width="160%" height="160%">
							<feDropShadow dx="0" dy="18" stdDeviation="18" flood-color="#173a91" flood-opacity="0.18" />
						</filter>
					</defs>

					<circle class="error-halo" cx="320" cy="215" r="186" />
					<circle class="error-orbit error-orbit-outer" cx="320" cy="215" r="154" />
					<circle class="error-orbit error-orbit-inner" cx="320" cy="215" r="126" />

					<text class="error-four error-four-shadow" x="40" y="308">4</text>
					<text class="error-four" x="28" y="296">4</text>

					<g filter="url(#error-shadow)">
						<circle class="error-zero" cx="320" cy="215" r="101" />
						<circle class="error-zero-cutout" cx="320" cy="215" r="47" />
					</g>

					<text class="error-four error-four-shadow" x="423" y="308">4</text>
					<text class="error-four" x="411" y="296">4</text>

					<g class="error-marker error-marker-top">
						<path d="M0 8h16M8 0v16" />
					</g>
					<g class="error-marker error-marker-bottom">
						<path d="M0 8h16M8 0v16" />
					</g>
					<circle class="error-dot error-dot-one" cx="492" cy="92" r="7" />
					<circle class="error-dot error-dot-two" cx="144" cy="350" r="5" />
					<path class="error-corner" d="M516 326h54v-54" />
				</svg>
			</div>
		</div>
	</section>
</PortfolioLayout>

<style>
	.not-found {
		position: relative;
		display: grid;
		min-height: min(43rem, calc(100vh - 5.5rem));
		align-items: center;
		overflow: hidden;
		padding: clamp(5rem, 10vw, 8.5rem) 0 clamp(4.5rem, 8vw, 7rem);
		background:
			radial-gradient(circle at 82% 42%, rgba(47, 105, 255, 0.11), transparent 23rem),
			linear-gradient(180deg, #f8faff 0%, #f7f9ff 100%);
	}

	.not-found::before {
		position: absolute;
		top: 0;
		right: 0;
		width: min(48vw, 46rem);
		height: 100%;
		background-image: radial-gradient(rgba(44, 99, 241, 0.1) 1px, transparent 1px);
		background-size: 24px 24px;
		mask-image: linear-gradient(to left, black, transparent 92%);
		content: "";
	}

	.not-found-grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.82fr) minmax(25rem, 1.18fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: center;
	}

	.not-found-copy {
		position: relative;
		z-index: 1;
	}

	.not-found-copy h1 {
		max-width: 36rem;
		margin: 0;
		font-family: "Manrope", sans-serif;
		font-size: clamp(3rem, 5.4vw, 5.2rem);
		font-weight: 800;
		line-height: 1.02;
		letter-spacing: -0.065em;
		color: var(--text);
	}

	.not-found-message {
		max-width: 34rem;
		margin: 1.4rem 0 0;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--muted);
	}

	.not-found-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2rem;
	}

	.not-found-primary {
		background: var(--accent) !important;
		box-shadow: 0 12px 28px rgba(44, 99, 241, 0.2);
	}

	.not-found-visual {
		position: relative;
		min-height: 27rem;
	}

	.not-found-visual::before {
		position: absolute;
		inset: 10% 4% 8% 7%;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(44, 99, 241, 0.09), transparent 68%);
		content: "";
	}

	.not-found-visual svg {
		position: absolute;
		inset: 50% auto auto 50%;
		width: 100%;
		max-width: 40rem;
		height: auto;
		overflow: visible;
		transform: translate(-50%, -50%);
	}

	.error-halo {
		fill: rgba(255, 255, 255, 0.62);
		stroke: rgba(44, 99, 241, 0.08);
	}

	.error-orbit {
		fill: none;
		stroke: rgba(44, 99, 241, 0.16);
		stroke-width: 1.5;
	}

	.error-orbit-outer {
		stroke-dasharray: 3 14;
	}

	.error-orbit-inner {
		stroke-dasharray: 82 24;
	}

	.error-four {
		fill: #0f1b3d;
		font-family: "Manrope", sans-serif;
		font-size: 255px;
		font-weight: 800;
		letter-spacing: -0.09em;
	}

	.error-four-shadow {
		fill: none;
		stroke: rgba(44, 99, 241, 0.17);
		stroke-width: 3;
	}

	.error-zero {
		fill: url("#error-zero");
	}

	.error-zero-cutout {
		fill: #f8faff;
		stroke: rgba(255, 255, 255, 0.8);
		stroke-width: 7;
	}

	.error-marker path,
	.error-corner {
		fill: none;
		stroke: #ef8d75;
		stroke-linecap: round;
		stroke-width: 3;
	}

	.error-marker-top {
		transform: translate(158px, 72px);
	}

	.error-marker-bottom {
		transform: translate(462px, 344px);
	}

	.error-dot {
		fill: #45bfae;
	}

	.error-dot-two {
		fill: #2c63f1;
	}

	.error-corner {
		stroke: rgba(44, 99, 241, 0.32);
		stroke-width: 2;
	}

	@media (max-width: 900px) {
		.not-found-grid {
			grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.9fr);
			gap: 1.5rem;
		}

		.not-found-visual {
			min-height: 22rem;
		}
	}

	@media (max-width: 720px) {
		.not-found {
			min-height: auto;
			padding: 5.5rem 0 4rem;
		}

		.not-found-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.not-found-copy h1 {
			font-size: clamp(2.8rem, 14vw, 4rem);
		}

		.not-found-visual {
			min-height: clamp(15rem, 65vw, 20rem);
		}

		.not-found-visual svg {
			width: min(100%, 34rem);
		}
	}

	@media (max-width: 430px) {
		.not-found-actions {
			display: grid;
		}

		.not-found-actions .button {
			width: 100%;
		}
	}
</style>
