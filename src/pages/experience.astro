---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import { experienceItems } from "../data/portfolio";

const experienceKeywords = new Set([
	"maintained",
	"enhanced",
	"react",
	"native",
	"xamarin",
	"pilots",
	"implemented",
	"aerospace",
	"requirements",
	"multinational",
	"team",
	"event-driven",
	"workflows",
	"s3",
	"notifications",
	"dynamodb",
	"streams",
	"deployed",
	"built",
	"resolved",
	"cloudformation's",
	"500-resource",
	"limit",
	"monitored",
	"production",
	"cloudwatch",
	"logs",
	"datadog",
	"escalated",
	"critical",
	"led",
	"development",
	"delivered",
	"ibanking",
	"exchange",
	"counter",
	"single-page",
	"applications",
	"improved",
	"usability",
	"performance",
]);

const highlightKeywords = (text) =>
	text.split(/(\s+)/).map((part) => ({
		text: part,
		highlighted: experienceKeywords.has(part.replace(/^[.,;:()']+|[.,;:()']+$/g, "").toLowerCase()),
	}));
---

<PortfolioLayout title="Htet Lin Maung | Experience" currentPath="/experience">
	<section class="page-banner">
		<div class="container">
			<p class="eyebrow">Experience</p>
			<h1>Experience across software engineering, cloud systems, and team delivery.</h1>
			<p>
				My experience spans frontend development, backend systems, team leadership, and
				AWS-based application delivery, with a focus on practical execution and maintainable
				architecture.
			</p>
		</div>
	</section>

	<section class="section experience-shell">
		<div class="container">
			<div class="timeline">
				{
					experienceItems.map((item) => (
						<article class="timeline-item">
							<p class="timeline-period">{item.period}</p>
							<div class="timeline-meta" aria-hidden="true"></div>
							<div class="timeline-card">
								<h3>{item.title}</h3>
								<div class="timeline-body">
								<div class="timeline-copy">
									<p class="timeline-org">{item.org}</p>
									<ul class="timeline-details">
										{
											item.details.map((detail) => (
												<li>
													{highlightKeywords(detail).map((part) =>
														part.highlighted ? <strong>{part.text}</strong> : part.text
													)}
												</li>
											))
										}
									</ul>
								</div>
									<p class="timeline-tech">Tech: {item.tech}</p>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>
</PortfolioLayout>
