---
import Icon from "../components/Icon.astro";
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import { contactItems } from "../data/portfolio";
---

<PortfolioLayout title="Htet Lin Maung | Contact" currentPath="/contact">
	<section class="page-banner">
		<div class="container">
			<p class="eyebrow">Contact</p>
			<h1>Let’s discuss product ideas, engineering work, or collaboration.</h1>
			<p>
				If you’re hiring, collaborating, or exploring a project, the easiest way to reach me is by
				email. I’m happy to connect about software engineering roles, freelance work, or product
				ideas.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container contact-layout">
			<article class="contact-info">
				<h3>Get In Touch</h3>
				<p class="contact-intro">
					I’m open to discussing engineering opportunities, freelance builds, and practical
					product collaboration.
				</p>

				<div class="contact-details">
					{
						contactItems.map((item) => (
							<div class="contact-item">
								<div class:list={["icon-wrap", `icon-${item.icon}`]}>
									<Icon name={item.icon} />
								</div>
								<p>
									<strong>{item.label}</strong>
									{
										item.icon === "contactEmail" ? (
											item.value
										) : item.href ? (
											<a href={item.href}>{item.value}</a>
										) : (
											item.value
										)
									}
								</p>
							</div>
						))
					}
				</div>
			</article>

			<article class="contact-form-card">
				<form class="contact-form" id="form" data-contact-form>
					<input type="hidden" name="access_key" value="18664d81-3279-4dae-ad1e-da39b79ef96a" />
					<input type="hidden" name="from_name" value="Htet Lin Maung Portfolio" />
					<input
						class="form-botcheck"
						type="checkbox"
						name="botcheck"
						tabindex="-1"
						autocomplete="off"
						aria-hidden="true"
					/>

					<div class="form-field">
						<label for="contact-name">Your Name</label>
						<input
							id="contact-name"
							name="name"
							type="text"
							placeholder="Enter your name"
							autocomplete="name"
							required
						/>
					</div>

					<div class="form-field">
						<label for="contact-email">Your Email</label>
						<input
							id="contact-email"
							name="email"
							type="email"
							placeholder="Enter your email"
							autocomplete="email"
							required
						/>
					</div>

					<div class="form-field">
						<label for="contact-subject">Subject</label>
						<input
							id="contact-subject"
							name="subject"
							type="text"
							placeholder="Enter subject"
							required
						/>
					</div>

					<div class="form-field">
						<label for="contact-message">Message</label>
						<textarea
							id="contact-message"
							name="message"
							placeholder="Write your message..."
							required
						></textarea>
					</div>

					<button class="button primary contact-submit" type="submit">
						<Icon name="mail" />
						<span data-submit-label>Send Message</span>
					</button>

					<div class="form-status" data-form-status role="status" aria-live="polite" hidden>
						<span class="form-status-icon" aria-hidden="true">
							<Icon name="statusLoading" className="form-state-icon form-state-icon-loading" />
							<Icon name="statusSuccess" className="form-state-icon form-state-icon-success" />
							<Icon name="statusError" className="form-state-icon form-state-icon-error" />
						</span>
						<div>
							<strong data-status-title></strong>
							<span data-status-message></span>
						</div>
					</div>
				</form>
			</article>
		</div>
	</section>
</PortfolioLayout>

<script>
	const WEB3FORMS_ENABLED = true;

	const initContactForm = () => {
		const form = document.querySelector("[data-contact-form]");
		if (!(form instanceof HTMLFormElement) || form.dataset.bound === "true") return;

		const submitButton = form.querySelector('button[type="submit"]');
		const submitLabel = form.querySelector("[data-submit-label]");
		const status = form.querySelector("[data-form-status]");
		const statusTitle = form.querySelector("[data-status-title]");
		const statusMessage = form.querySelector("[data-status-message]");

		if (!(submitButton instanceof HTMLButtonElement) || !submitLabel) return;
		form.dataset.bound = "true";

		const showStatus = (type, title, message) => {
			if (!(status instanceof HTMLElement) || !statusTitle || !statusMessage) return;

			status.hidden = false;
			status.dataset.state = type;
			statusTitle.textContent = title;
			statusMessage.textContent = message;
		};

		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			const data = new FormData(form);
			submitButton.disabled = true;
			submitButton.classList.add("is-loading");
			submitButton.setAttribute("aria-busy", "true");
			submitLabel.textContent = "Sending...";
			showStatus("loading", "Sending your message", "Please wait while your message is delivered.");

			try {
				if (!WEB3FORMS_ENABLED) {
					await new Promise((resolve) => window.setTimeout(resolve, 700));
					form.reset();
					showStatus(
						"success",
						"Message sent successfully",
						"Thank you for reaching out. I’ll get back to you as soon as possible."
					);
					return;
				}

				const response = await fetch("https://api.web3forms.com/submit", {
					method: "POST",
					body: data,
				});
				const result = await response.json();

				if (response.ok && result.success !== false) {
					form.reset();
					showStatus(
						"success",
						"Message sent successfully",
						"Thank you for reaching out. I’ll get back to you as soon as possible."
					);
				} else {
					showStatus(
						"error",
						"Message could not be sent",
						result.message || "Please check your details and try again."
					);
				}
			} catch {
				showStatus(
					"error",
					"Connection problem",
					"Your message was not sent. Please check your connection and try again."
				);
			} finally {
				submitButton.disabled = false;
				submitButton.classList.remove("is-loading");
				submitButton.removeAttribute("aria-busy");
				submitLabel.textContent = "Send Message";
			}
		});
	};

	initContactForm();
	document.addEventListener("astro:page-load", initContactForm);
</script>
