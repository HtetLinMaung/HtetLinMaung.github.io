---
import Icon from "./Icon.astro";

const { compact = false } = Astro.props;
---

<div class:list={["exchange-project-visual", { compact }]} aria-hidden="true">
	<svg class="exchange-backdrop" viewBox="0 0 760 430" preserveAspectRatio="none">
		<path d="M-30 356C116 242 213 396 348 261C470 138 575 201 797 43"></path>
		<circle cx="642" cy="91" r="69"></circle>
		<circle cx="104" cy="108" r="38"></circle>
	</svg>

	<div class="exchange-cloud-badge">
		<Icon name="skillAws" />
		<span>Serverless exchange operations</span>
	</div>

	<div class="exchange-terminal">
		<div class="terminal-topbar">
			<div class="terminal-logo"><span>FX</span> Counter</div>
			<div class="terminal-user"><i></i><span>Teller 02</span></div>
		</div>
		<div class="terminal-layout">
			<aside><b></b><i></i><i></i><i></i><i></i></aside>
			<div class="terminal-content">
				<div class="rate-heading"><span>Today’s rates</span><small>Branch 001</small></div>
				<div class="rate-board">
					<div><strong>USD</strong><span>Buy 34.10</span><b>34.55</b></div>
					<div><strong>EUR</strong><span>Buy 39.20</span><b>39.80</b></div>
					<div><strong>JPY</strong><span>Buy 0.229</span><b>0.235</b></div>
				</div>
				<div class="exchange-form">
					<div><small>Customer gives</small><strong>1,200 <span>USD</span></strong></div>
					<i>⇄</i>
					<div><small>Customer receives</small><strong>41,460 <span>THB</span></strong></div>
				</div>
				<div class="terminal-action"><span>Cash verified</span><b>Complete exchange</b></div>
			</div>
		</div>
	</div>

	<div class="cash-tray">
		<div class="cash-stack cash-blue"><span>100</span><i></i><i></i></div>
		<div class="cash-stack cash-warm"><span>50</span><i></i><i></i></div>
		<div class="cash-coins"><i>¥</i><i>$</i><i>€</i></div>
		<strong>Cash inventory</strong>
		<small>Denominations tracked</small>
	</div>

	<div class="exchange-service service-rust"><Icon name="skillRust" /><span>Rust API</span></div>
	<div class="exchange-service service-postgres"><Icon name="skillPostgres" /><span>Atomic ledger</span></div>
</div>

<style>
	.exchange-project-visual {
		position: relative;
		width: 100%;
		min-height: 20rem;
		container-type: inline-size;
		overflow: hidden;
		border: 1px solid #dce5f7;
		border-radius: 1.35rem;
		background:
			radial-gradient(circle at 14% 22%, rgba(56, 171, 151, 0.13), transparent 0 25%),
			linear-gradient(145deg, #fbfdff 0%, #edf4ff 100%);
		box-shadow: 0 18px 42px rgba(15, 27, 61, 0.075);
		font-family: "Manrope", sans-serif;
	}

	.exchange-backdrop {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.exchange-backdrop path,
	.exchange-backdrop circle {
		fill: none;
		stroke: rgba(47, 105, 255, 0.13);
		stroke-width: 1.25;
		stroke-dasharray: 5 8;
		vector-effect: non-scaling-stroke;
	}

	.exchange-cloud-badge,
	.exchange-terminal,
	.cash-tray,
	.exchange-service {
		position: absolute;
		z-index: 2;
	}

	.exchange-cloud-badge {
		right: 5%;
		top: 6%;
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.54rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		color: #607293;
	}

	.exchange-cloud-badge :global(.icon) {
		width: 1.65rem;
		height: 1.1rem;
		color: #26364f;
	}

	.exchange-terminal {
		right: 6%;
		top: 15%;
		width: 72%;
		height: 68%;
		overflow: hidden;
		border: 1px solid #d4def1;
		border-radius: 0.9rem;
		background: rgba(255, 255, 255, 0.97);
		box-shadow: 0 22px 44px rgba(24, 45, 87, 0.13);
		transform: rotate(-1deg);
	}

	.terminal-topbar {
		display: flex;
		height: 14%;
		align-items: center;
		justify-content: space-between;
		padding: 0 0.85rem;
		border-bottom: 1px solid #e2e9f6;
		background: #f4f7fc;
	}

	.terminal-logo,
	.terminal-user {
		display: flex;
		align-items: center;
		gap: 0.38rem;
		font-size: 0.48rem;
		font-weight: 800;
		color: #435572;
	}

	.terminal-logo span {
		display: grid;
		width: 1.25rem;
		height: 1.25rem;
		place-items: center;
		border-radius: 0.35rem;
		background: #2f69ff;
		font-size: 0.48rem;
		color: white;
	}

	.terminal-user i {
		width: 0.52rem;
		height: 0.52rem;
		border-radius: 50%;
		background: #42b7a4;
	}

	.terminal-layout {
		display: grid;
		grid-template-columns: 12% 1fr;
		height: 86%;
	}

	.terminal-layout aside {
		display: grid;
		align-content: start;
		justify-items: center;
		gap: 0.72rem;
		padding-top: 0.9rem;
		background: #17294d;
	}

	.terminal-layout aside b,
	.terminal-layout aside i {
		width: 34%;
		height: 0.22rem;
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.32);
	}

	.terminal-layout aside b {
		width: 1.1rem;
		height: 1.1rem;
		margin-bottom: 0.2rem;
		border-radius: 0.3rem;
		background: #42b7a4;
	}

	.terminal-content {
		padding: 0.72rem 0.9rem;
	}

	.rate-heading,
	.terminal-action {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.rate-heading span {
		font-size: 0.58rem;
		font-weight: 800;
		color: #1b2f53;
	}

	.rate-heading small,
	.exchange-form small {
		font-size: 0.4rem;
		color: #8491a7;
	}

	.rate-board {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.4rem;
		margin-top: 0.52rem;
	}

	.rate-board > div {
		display: grid;
		gap: 0.12rem;
		padding: 0.45rem 0.52rem;
		border: 1px solid #e1e8f5;
		border-radius: 0.48rem;
		background: #fbfcff;
	}

	.rate-board strong,
	.rate-board b {
		font-size: 0.48rem;
		color: #203655;
	}

	.rate-board span {
		font-size: 0.34rem;
		color: #7c899f;
	}

	.rate-board b {
		color: #2f69ff;
	}

	.exchange-form {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 0.45rem;
		align-items: center;
		margin-top: 0.55rem;
	}

	.exchange-form > div {
		display: grid;
		gap: 0.17rem;
		padding: 0.42rem 0.55rem;
		border-radius: 0.45rem;
		background: #edf3ff;
	}

	.exchange-form strong {
		font-size: 0.55rem;
		color: #1d345a;
	}

	.exchange-form strong span {
		font-size: 0.36rem;
		color: #6e7f9a;
	}

	.exchange-form > i {
		font-size: 0.72rem;
		font-style: normal;
		color: #2f69ff;
	}

	.terminal-action {
		margin-top: 0.52rem;
		font-size: 0.4rem;
		color: #2b8f7e;
	}

	.terminal-action b {
		padding: 0.38rem 0.55rem;
		border-radius: 0.4rem;
		background: #2f69ff;
		font-size: 0.4rem;
		color: white;
	}

	.cash-tray {
		left: 4%;
		bottom: 8%;
		width: 28%;
		padding: 0.65rem 0.65rem 0.58rem;
		border: 1px solid #d9e2f2;
		border-radius: 0.72rem;
		background: rgba(255, 255, 255, 0.96);
		box-shadow: 0 13px 28px rgba(27, 48, 88, 0.12);
	}

	.cash-stack {
		position: relative;
		display: inline-grid;
		width: 38%;
		height: 2.05rem;
		place-items: center;
		border-radius: 0.3rem;
		background: #477be7;
		color: white;
	}

	.cash-stack + .cash-stack {
		margin-left: 0.3rem;
	}

	.cash-stack span {
		font-size: 0.58rem;
		font-weight: 800;
	}

	.cash-stack i {
		position: absolute;
		inset: -0.14rem 0.14rem auto;
		height: 100%;
		border: 1px solid rgba(26, 57, 118, 0.2);
		border-radius: inherit;
		z-index: -1;
	}

	.cash-stack i + i { inset: -0.27rem 0.28rem auto; }
	.cash-warm { background: #e98a42; }

	.cash-coins {
		position: absolute;
		right: 0.58rem;
		top: -0.85rem;
		display: flex;
	}

	.cash-coins i {
		display: grid;
		width: 1.35rem;
		height: 1.35rem;
		place-items: center;
		margin-left: -0.3rem;
		border: 2px solid white;
		border-radius: 50%;
		background: #f1b94a;
		box-shadow: 0 5px 10px rgba(89, 64, 20, 0.14);
		font-size: 0.48rem;
		font-style: normal;
		font-weight: 800;
		color: #654a18;
	}

	.cash-tray strong,
	.cash-tray small {
		display: block;
	}

	.cash-tray strong {
		margin-top: 0.55rem;
		font-size: 0.52rem;
		color: #263a59;
	}

	.cash-tray small {
		margin-top: 0.1rem;
		font-size: 0.38rem;
		color: #7c8ba3;
	}

	.exchange-service {
		display: flex;
		align-items: center;
		gap: 0.38rem;
		padding: 0.42rem 0.58rem;
		border: 1px solid #dbe4f3;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.96);
		box-shadow: 0 8px 18px rgba(25, 47, 88, 0.09);
		font-size: 0.46rem;
		font-weight: 800;
		color: #3b4f6f;
	}

	.exchange-service :global(.icon) { width: 1rem; height: 1rem; }
	.service-rust { left: 5%; top: 16%; }
	.service-postgres { right: 8%; bottom: 8%; }

	@container (max-width: 540px) {
		.exchange-terminal { right: 4%; width: 76%; }
		.cash-tray { left: 3%; width: 30%; }
		.exchange-cloud-badge span { display: none; }
	}
</style>
