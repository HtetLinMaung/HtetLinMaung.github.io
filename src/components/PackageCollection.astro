---
import Icon from "./Icon.astro";

const { groups } = Astro.props;
const packageCount = groups.reduce((total, group) => total + group.packages.length, 0);
---

<article class="package-collection">
	<div class="package-collection-intro">
		<div class="package-collection-mark" aria-hidden="true">npm</div>
		<div>
			<p class="eyebrow">Open Source</p>
			<h3>npm Package Collection</h3>
			<p>
				{packageCount} focused TypeScript and JavaScript packages for document workflows,
				backend development, validation, and Myanmar-specific applications.
			</p>
		</div>
	</div>

	<div class="package-groups">
		{
			groups.map((group) => (
				<section class="package-group">
					<h4>{group.title}</h4>
					<div class="package-links">
						{group.packages.map((item) => (
							<a href={item.href} target="_blank" rel="noreferrer">
								{item.name}
								<Icon name="arrow" />
							</a>
						))}
					</div>
				</section>
			))
		}
	</div>
</article>
