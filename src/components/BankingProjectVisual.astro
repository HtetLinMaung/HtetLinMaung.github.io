---
import Icon from "./Icon.astro";

const { compact = false } = Astro.props;
---

<div class:list={["banking-project-visual", { compact }]} aria-hidden="true">
	<svg class="banking-art-lines" viewBox="0 0 760 430" preserveAspectRatio="none">
		<path d="M32 310C142 190 230 382 347 247C444 136 530 166 726 67"></path>
		<path d="M80 66C206 138 238 45 346 103C458 163 541 92 692 183"></path>
		<circle cx="682" cy="346" r="54"></circle>
		<circle cx="98" cy="104" r="34"></circle>
	</svg>

	<div class="banking-art-blob"></div>
	<div class="banking-art-dot dot-one"></div>
	<div class="banking-art-dot dot-two"></div>
	<div class="banking-art-dot dot-three"></div>

	<div class="banking-browser">
		<div class="browser-bar">
			<span></span><span></span><span></span>
			<div class="browser-brand"><Icon name="bankAngular" /> iBanking</div>
		</div>
		<div class="browser-content">
			<div class="browser-sidebar">
				<div class="sidebar-mark"></div>
				<i></i><i></i><i></i><i></i>
			</div>
			<div class="browser-dashboard">
				<div class="dashboard-heading">
					<div>
						<small>Available balance</small>
						<strong>$24,680.00</strong>
					</div>
					<span>••• 4821</span>
				</div>
				<div class="dashboard-chart">
					<span style="height: 28%"></span>
					<span style="height: 52%"></span>
					<span style="height: 43%"></span>
					<span style="height: 76%"></span>
					<span style="height: 60%"></span>
					<span style="height: 88%"></span>
				</div>
				<div class="dashboard-rows"><i></i><i></i><i></i></div>
			</div>
		</div>
	</div>

	<div class="banking-phone">
		<div class="phone-speaker"></div>
		<div class="phone-screen">
			<div class="phone-top">
				<Icon name="bankFlutter" />
				<span>9:41</span>
			</div>
			<small>Good morning</small>
			<strong>Htet Lin</strong>
			<div class="phone-card">
				<span>Current balance</span>
				<b>$8,420.60</b>
				<i>•••• 7318</i>
			</div>
			<div class="phone-actions">
				<span>↑</span><span>↓</span><span>•••</span>
			</div>
			<div class="phone-transactions">
				<i></i><i></i><i></i>
			</div>
		</div>
	</div>

	<div class="banking-float banking-shield">
		<svg viewBox="0 0 24 24">
			<path d="M12 2.8 19 5.6v5.2c0 4.5-2.8 8.5-7 10.4-4.2-1.9-7-5.9-7-10.4V5.6L12 2.8Z"></path>
			<path d="m8.8 12 2.1 2.1 4.5-4.6"></path>
		</svg>
	</div>

	<div class="banking-float banking-coin">
		<span>¥</span>
	</div>

	<div class="banking-cloud">
		<Icon name="serviceCloud" />
		<span>Secure cloud banking</span>
	</div>
</div>

<style>
	.banking-project-visual {
		position: relative;
		width: 100%;
		min-height: 20rem;
		container-type: inline-size;
		overflow: hidden;
		border: 1px solid #dce5f7;
		border-radius: 1.35rem;
		background:
			radial-gradient(circle at 18% 18%, rgba(78, 123, 229, 0.13), transparent 0 24%),
			linear-gradient(145deg, #fafdff 0%, #edf4ff 100%);
		box-shadow: 0 18px 42px rgba(15, 27, 61, 0.075);
	}

	.banking-art-lines {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.banking-art-lines path {
		fill: none;
		stroke: rgba(74, 111, 198, 0.15);
		stroke-width: 1.4;
		stroke-dasharray: 5 8;
		vector-effect: non-scaling-stroke;
	}

	.banking-art-lines circle {
		fill: none;
		stroke: rgba(74, 111, 198, 0.12);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}

	.banking-art-blob {
		position: absolute;
		right: -8%;
		bottom: -28%;
		width: 58%;
		aspect-ratio: 1;
		border-radius: 43% 57% 64% 36% / 51% 37% 63% 49%;
		background: rgba(47, 105, 255, 0.08);
		transform: rotate(-18deg);
	}

	.banking-art-dot {
		position: absolute;
		border-radius: 50%;
		background: #2f69ff;
		opacity: 0.28;
	}

	.dot-one {
		left: 7%;
		top: 15%;
		width: 0.45rem;
		height: 0.45rem;
	}

	.dot-two {
		right: 8%;
		top: 12%;
		width: 0.7rem;
		height: 0.7rem;
		background: #ef5777;
	}

	.dot-three {
		left: 46%;
		bottom: 9%;
		width: 0.35rem;
		height: 0.35rem;
		background: #e9902f;
	}

	.banking-browser {
		position: absolute;
		right: 7%;
		top: 14%;
		width: 68%;
		height: 66%;
		overflow: hidden;
		border: 1px solid #d5e0f5;
		border-radius: 0.9rem;
		background: rgba(255, 255, 255, 0.96);
		box-shadow: 0 20px 42px rgba(32, 52, 94, 0.12);
		transform: rotate(1.5deg);
	}

	.browser-bar {
		display: flex;
		align-items: center;
		gap: 0.28rem;
		height: 13%;
		padding: 0 0.75rem;
		background: #f2f6fd;
		border-bottom: 1px solid #e0e8f7;
	}

	.browser-bar > span {
		width: 0.32rem;
		height: 0.32rem;
		border-radius: 50%;
		background: #a7b4cc;
	}

	.browser-brand {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		margin-left: auto;
		font-family: "Manrope", sans-serif;
		font-size: 0.55rem;
		font-weight: 800;
		color: #42557a;
	}

	.browser-brand .icon {
		width: 0.9rem;
		height: 0.9rem;
	}

	.browser-content {
		display: grid;
		grid-template-columns: 18% 1fr;
		height: 87%;
	}

	.browser-sidebar {
		display: grid;
		align-content: start;
		justify-items: center;
		gap: 0.75rem;
		padding-top: 1rem;
		background: #17284d;
	}

	.sidebar-mark {
		width: 1.2rem;
		height: 1.2rem;
		margin-bottom: 0.25rem;
		border-radius: 0.35rem;
		background: #4f7fec;
	}

	.browser-sidebar i {
		width: 35%;
		height: 0.22rem;
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.32);
	}

	.browser-dashboard {
		padding: 1rem 1.1rem;
	}

	.dashboard-heading {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
	}

	.dashboard-heading div {
		display: grid;
		gap: 0.2rem;
	}

	.dashboard-heading small,
	.dashboard-heading span {
		font-size: 0.48rem;
		color: #8491aa;
	}

	.dashboard-heading strong {
		font-family: "Manrope", sans-serif;
		font-size: 1rem;
		color: #17284d;
	}

	.dashboard-heading > span {
		padding: 0.35rem 0.5rem;
		border-radius: 999px;
		background: #edf3ff;
	}

	.dashboard-chart {
		display: flex;
		align-items: flex-end;
		gap: 5%;
		height: 42%;
		margin: 0.8rem 0;
		padding: 0 0.5rem;
		border-bottom: 1px solid #dde6f7;
	}

	.dashboard-chart span {
		width: 9%;
		border-radius: 0.25rem 0.25rem 0 0;
		background: linear-gradient(180deg, #6390ef, #2f69ff);
	}

	.dashboard-rows {
		display: grid;
		gap: 0.45rem;
	}

	.dashboard-rows i {
		width: 100%;
		height: 0.36rem;
		border-radius: 1rem;
		background: #e9eef7;
	}

	.dashboard-rows i:nth-child(2) {
		width: 78%;
	}

	.dashboard-rows i:nth-child(3) {
		width: 88%;
	}

	.banking-phone {
		position: absolute;
		left: 8%;
		top: 15%;
		z-index: 3;
		width: 30%;
		height: 75%;
		padding: 0.38rem;
		border: 2px solid #18294e;
		border-radius: 1.45rem;
		background: #f9fbff;
		box-shadow: 0 22px 40px rgba(23, 40, 77, 0.2);
		transform: rotate(-4deg);
	}

	.phone-speaker {
		position: absolute;
		z-index: 2;
		left: 50%;
		top: 0.55rem;
		width: 28%;
		height: 0.2rem;
		border-radius: 1rem;
		background: #25375a;
		transform: translateX(-50%);
	}

	.phone-screen {
		height: 100%;
		padding: 1.3rem 0.7rem 0.7rem;
		overflow: hidden;
		border-radius: 1.05rem;
		background: linear-gradient(155deg, #ffffff, #eef4ff);
	}

	.phone-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.75rem;
	}

	.phone-top .icon {
		width: 1rem;
		height: 1rem;
	}

	.phone-top span,
	.phone-screen > small {
		font-size: 0.43rem;
		color: #8290aa;
	}

	.phone-screen > strong {
		display: block;
		margin-top: 0.12rem;
		font-family: "Manrope", sans-serif;
		font-size: 0.7rem;
		color: #17284d;
	}

	.phone-card {
		display: grid;
		gap: 0.3rem;
		margin-top: 0.65rem;
		padding: 0.75rem 0.65rem;
		border-radius: 0.75rem;
		background: linear-gradient(135deg, #1b315f, #3268d2);
		color: #fff;
		box-shadow: 0 10px 18px rgba(47, 105, 255, 0.2);
	}

	.phone-card span,
	.phone-card i {
		font-size: 0.4rem;
		font-style: normal;
		opacity: 0.72;
	}

	.phone-card b {
		font-family: "Manrope", sans-serif;
		font-size: 0.74rem;
	}

	.phone-actions {
		display: flex;
		justify-content: space-between;
		margin: 0.7rem 0;
	}

	.phone-actions span {
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 50%;
		background: #e5edff;
		font-size: 0.65rem;
		font-weight: 800;
		color: #2f69ff;
	}

	.phone-transactions {
		display: grid;
		gap: 0.45rem;
	}

	.phone-transactions i {
		width: 100%;
		height: 0.28rem;
		border-radius: 1rem;
		background: #dfe7f4;
	}

	.phone-transactions i:nth-child(2) {
		width: 75%;
	}

	.banking-float {
		position: absolute;
		z-index: 4;
		display: grid;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.85);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.94);
		box-shadow: 0 12px 26px rgba(26, 46, 85, 0.16);
	}

	.banking-shield {
		right: 5%;
		top: 8%;
		width: 3.5rem;
		height: 3.5rem;
		color: #2f69ff;
	}

	.banking-shield svg {
		width: 1.9rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.banking-coin {
		right: 8%;
		bottom: 7%;
		width: 3rem;
		height: 3rem;
		color: #bd781d;
		background: #fff8e8;
	}

	.banking-coin span {
		font-family: "Manrope", sans-serif;
		font-size: 1.25rem;
		font-weight: 800;
	}

	.banking-cloud {
		position: absolute;
		z-index: 4;
		left: 39%;
		bottom: 4.5%;
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.48rem 0.68rem;
		border: 1px solid #dbe5f7;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.94);
		box-shadow: 0 8px 18px rgba(23, 42, 80, 0.09);
		font-family: "Manrope", sans-serif;
		font-size: 0.58rem;
		font-weight: 800;
		color: #4a5e82;
	}

	.banking-cloud .icon {
		width: 1.1rem;
		height: 1.1rem;
		color: #2f69ff;
	}

	.compact {
		min-height: 100%;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}

	.compact .banking-browser {
		right: 5%;
		top: 13%;
		width: 70%;
		height: 68%;
	}

	.compact .banking-phone {
		left: 7%;
		top: 13%;
		width: 31%;
		height: 77%;
	}

	.compact .banking-shield {
		right: 4%;
		width: 2.7rem;
		height: 2.7rem;
	}

	.compact .banking-shield svg {
		width: 1.45rem;
	}

	.compact .banking-coin {
		right: 5%;
		width: 2.4rem;
		height: 2.4rem;
	}

	.compact .banking-coin span {
		font-size: 1rem;
	}

	.compact .banking-cloud {
		left: 42%;
		bottom: 3%;
	}

	@container (max-width: 25rem) {
		.banking-cloud span {
			display: none;
		}

		.banking-cloud {
			left: 46%;
			padding: 0.45rem;
		}

		.dashboard-heading span {
			display: none;
		}
	}

	@media (max-width: 760px) {
		.banking-project-visual:not(.compact) {
			min-height: 17rem;
		}
	}
</style>
